# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional overrides
PROMPT_MODEL=openai/gpt-4.1-mini
NANO_BANANA_MODEL=google/gemini-3-pro-image
OPENAI_IMAGE_MODEL=openai/gpt-image-2.6-sunburst
PROFILE_PATH=profile.yaml
REFERENCE_DIR=references
OUTPUT_DIR=outputs
LOG_DIR=logs
LOG_LEVEL=INFO
IMAGE_TIMEOUT_SECONDS=240

